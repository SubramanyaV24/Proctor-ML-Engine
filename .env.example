# ---------------------------------------------------------------
# Proctor-ML-Engine  –  environment variables
# Copy this file to .env and fill in values for your deployment.
# ---------------------------------------------------------------

# Directory where model weights are stored / downloaded to
MODEL_WEIGHTS_DIR=./model_weights

# Directory for session log files
LOGS_DIR=./logs

# Allowed CORS origins (comma-separated). Use * to allow all.
CORS_ORIGINS=*

# Maximum allowed payload size in bytes (default 5 MB)
MAX_PAYLOAD_BYTES=5242880

# ---- Inference thresholds (optional overrides) ----
YUNET_SCORE_THRESHOLD=0.3
FACE_SCORE_MIN=0.35
MEDIAPIPE_MIN_CONFIDENCE=0.5
GAZE_YAW_THRESHOLD=25.0
GAZE_PITCH_THRESHOLD=20.0
YOLO_PERSON_CONFIDENCE=0.65
CONF_CELL_PHONE=0.40
PHONE_MIN_AREA_FRAC=0.001
PHONE_MAX_ASPECT=10.0
CONF_LAPTOP=0.70
CONF_BOOK=0.70
CONF_TV=0.70
